/-! ### The phase tree restricted to a good set of vertices -/

section Restricted


/-- A cap moment: a function of the hierarchy (HJ's `hierQ`, or the clipped `hierQd`). -/
abbrev QFun := ∀ {Ω : Type}, List (Interval Ω) → ℝ

/-- The resources of a vertex, with the cap moment `Qf`. -/
noncomputable def vstate (P : Params) (Qf : QFun) (p : PNode P) : PotentialState :=
  { p.leaf.state P.κ with Q := Qf p.leaf.S.hier }

/-- The clause of `Row.Child` on the cap moment. -/
def qClause (cc : ChargingConstants) (qX qU : ℝ) : Row → Prop
  | .continuation q => qU ≤ qX - cBeta cc.β * Real.log q
  | _ => qU ≤ qX

theorem child_withQ (cc : ChargingConstants) {X U : PotentialState} {R : Row}
    (h : R.Child cc X U) {qX qU : ℝ} (hq : qClause cc qX qU R) :
    R.Child cc { X with Q := qX } { U with Q := qU } := by
  cases R <;> (obtain ⟨h1, h2, h3, -, h5⟩ := h; exact ⟨h1, h2, h3, hq, h5⟩)

theorem valid_withQ (cc : ChargingConstants) {X : PotentialState} {R : Row}
    (h : R.Valid cc X) {q : ℝ} : R.Valid cc { X with Q := q } := by
  cases R <;> exact h

theorem orbitChild_withQ {X U : PotentialState} (h : GI.Paper.OrbitChild X U) {qX qU : ℝ}
    (hq : qU ≤ qX) : GI.Paper.OrbitChild { X with Q := qX } { U with Q := qU } :=
  ⟨h.1, h.2.1, hq, h.2.2.2⟩

/-- `multL` is monotone in `Λ` on valid rows. -/
theorem multL_mono (cc : ChargingConstants) {Λ Λ' : ℝ} (h0 : 0 ≤ Λ) (h : Λ ≤ Λ')
    {X : PotentialState} {R : Row} (hv : R.Valid cc X) :
    Row'.multL cc Λ R ≤ Row'.multL cc Λ' R := by
  have hA := cc.aStar_nonneg
  have ha := cc.a_pos
  cases R with
  | affected =>
    simp only [Row'.multL]
    exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left h hA)
  | unaffected =>
    simp only [Row'.multL]
    exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left h hA)
  | product r =>
    obtain ⟨hr, -⟩ := hv
    have hr2 : (2 : ℝ) ≤ r := by exact_mod_cast hr
    simp only [Row'.multL]
    apply Real.exp_le_exp.mpr
    exact mul_le_mul_of_nonneg_left h (by nlinarith)
  | enumeration d =>
    obtain ⟨hd, -⟩ := hv
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    have hl : 0 ≤ Real.log d := Real.log_nonneg (by linarith)
    simp only [Row'.multL]
    apply Real.exp_le_exp.mpr
    have hc : 0 ≤ cc.a + cc.aStar / Real.log 2 := by
      have := ChargingConstants.log_two_pos'; positivity
    calc (cc.a + cc.aStar / Real.log 2) * Λ * Real.log d
        ≤ (cc.a + cc.aStar / Real.log 2) * Λ' * Real.log d := by
          apply mul_le_mul_of_nonneg_right _ hl
          exact mul_le_mul_of_nonneg_left h hc
      _ = _ := rfl
  | continuation q => simp only [Row'.multL]; exact le_refl _
  | rowEvent => simp only [Row'.multL]; exact le_refl _

open Classical in
/-- The phase tree of HJ's runs, restricted to the vertices `Good` (for Theorem R*: the runs
whose group lies in `Γ̂_d`). Other vertices are isolated leaves with zero resources, like the
vertices outside the phase in `phaseTree`. -/
noncomputable def phaseTreeOn (P : Params) (N : ℕ) (cost : PNode P → ℝ)
    (Good : PNode P → Prop) (Qf : QFun) : PhaseTree (PNode P) where
  state p := if p.Inv N ∧ Good p then vstate P Qf p else ⟨0, 0, 0, 0, 0⟩
  kind p := if p.Inv N ∧ Good p then p.rawKind else .leaf
  cost := cost

variable {N : ℕ} {cost : PNode P → ℝ} {Good : PNode P → Prop} {Qf : QFun}

theorem phaseTreeOn_state_of {v : PNode P} (hv : v.Inv N) (hg : Good v) :
    (phaseTreeOn P N cost Good Qf).state v = vstate P Qf v := by
  simp [phaseTreeOn, hv, hg]

theorem phaseTreeOn_kind_of {v : PNode P} (hv : v.Inv N) (hg : Good v) :
    (phaseTreeOn P N cost Good Qf).kind v = v.rawKind := by
  simp [phaseTreeOn, hv, hg]

theorem phaseTreeOn_kind_not {v : PNode P} (hv : ¬ (v.Inv N ∧ Good v)) :
    (phaseTreeOn P N cost Good Qf).kind v = .leaf := by
  simp [phaseTreeOn, hv]

theorem phaseTreeOn_state_not {v : PNode P} (hv : ¬ (v.Inv N ∧ Good v)) :
    (phaseTreeOn P N cost Good Qf).state v = ⟨0, 0, 0, 0, 0⟩ := by
  simp [phaseTreeOn, hv]

theorem phaseTreeOn_charged {v : PNode P} {cls : List (ChildClass (PNode P))}
    (hk : (phaseTreeOn P N cost Good Qf).kind v = .charged cls) :
    v.Inv N ∧ Good v ∧ v.leaf.pt = none ∧ runKind v.leaf.run = .charged cls := by
  by_cases hv : v.Inv N ∧ Good v
  · rw [phaseTreeOn_kind_of hv.1 hv.2] at hk
    refine ⟨hv.1, hv.2, ?_⟩
    unfold PNode.rawKind at hk
    split at hk
    · cases hk
    · exact ⟨by assumption, hk⟩
  · rw [phaseTreeOn_kind_not hv] at hk; cases hk

theorem phaseTreeOn_orbit {v : PNode P} {cs : List (PNode P)}
    (hk : (phaseTreeOn P N cost Good Qf).kind v = .orbit cs) :
    v.Inv N ∧ Good v ∧ v.leaf.pt = none ∧ runKind v.leaf.run = .orbit cs := by
  by_cases hv : v.Inv N ∧ Good v
  · rw [phaseTreeOn_kind_of hv.1 hv.2] at hk
    refine ⟨hv.1, hv.2, ?_⟩
    unfold PNode.rawKind at hk
    split at hk
    · cases hk
    · exact ⟨by assumption, hk⟩
  · rw [phaseTreeOn_kind_not hv] at hk; cases hk

theorem mem_children_of_class {cls : List (ChildClass (PNode P))} {c : ChildClass (PNode P)}
    (hc : c ∈ cls) {b : List (PNode P)} (hb : b ∈ c.branches) {u : PNode P} (hu : u ∈ b) :
    u ∈ (NodeKind.charged cls).children := by
  simp only [NodeKind.children]
  exact List.mem_flatten.2 ⟨_, List.mem_map_of_mem hc, List.mem_flatten.2 ⟨b, hb, hu⟩⟩


/-- **The phase tree of `M.Run`, restricted to `Good`, satisfies the hypotheses of Lemma 7.1**,
with constant weight `Λ ≥ lam d` and any cap moment `Qf` with the row clauses `hq_charged`,
`hq_orbit`. A `Good` vertex has the local bounds (`Run.VertexBound`). -/
theorem phaseTreeOn_hypL {cc : ChargingConstants} (hc : Compat P cc) (hN6 : 6 ≤ (N : ℝ) ^ cc.γ)
    {d : ℕ} (hab : ((2 * P.κ : ℕ) : ℝ) + Real.log (9 : ℕ) / Real.log 48 ≤ cc.aStar) (K : ℝ)
    {Λ : ℝ} (hΛ : lam d ≤ Λ)
    (hclosed : ∀ v, v.Inv N → Good v → ∀ u, u ∈ v.rawKind.children → u.Inv N → Good u)
    (hbound : ∀ v, v.Inv N → Good v → v.leaf.run.VertexBound cc d)
    (hq0 : ∀ {Ω : Type} (l : List (Interval Ω)), 0 ≤ Qf l)
    (hq_charged : ∀ v, v.Inv N → Good v → v.leaf.pt = none → ∀ cls,
      runKind v.leaf.run = .charged cls → ∀ c ∈ cls, ∀ b ∈ c.branches, ∀ u ∈ b,
        qClause cc (Qf v.leaf.S.hier) (Qf u.leaf.S.hier) c.row)
    (hq_orbit : ∀ v, v.Inv N → Good v → v.leaf.pt = none → ∀ cs,
      runKind v.leaf.run = .orbit cs → ∀ u ∈ cs, Qf u.leaf.S.hier ≤ Qf v.leaf.S.hier)
    (leaf_cost : ∀ v, (phaseTreeOn P N cost Good Qf).kind v = .leaf → cost v ≤ K)
    (toll : ∀ v, (phaseTreeOn P N cost Good Qf).kind v ≠ .leaf →
      cost v ≤ (N : ℝ) ^ cc.a * K +
        (((phaseTreeOn P N cost Good Qf).kind v).children.map cost).sum) :
    (phaseTreeOn P N cost Good Qf).HypL cc (fun _ => Λ) N K := by
  have hκ := hc.κ_five
  have hN2 : 2 ≤ N := two_le_of_six_le cc.γ_pos.le hN6
  have hγ : cc.γ = P.γ := hc.γ_eq
  have hΛ0 : 0 ≤ lam d := (lam_pos d).le
  set T := phaseTreeOn P N cost Good Qf with hT
  have hst : ∀ u, u.Inv N → Good u → T.state u = vstate P Qf u :=
    fun u hu hg => phaseTreeOn_state_of hu hg
  -- classes of a charged vertex
  have hcls : ∀ v cls, T.kind v = .charged cls →
      v.Inv N ∧ Good v ∧ cls.length ≤ 6 ∧ ∀ c ∈ cls, ClassOK cc N (v.leaf.state P.κ) c := by
    intro v cls hk
    obtain ⟨hv, hg, hpt, hk'⟩ := phaseTreeOn_charged hk
    refine ⟨hv, hg, ?_⟩
    obtain ⟨Ω, m, C, S, L, A, r, pt⟩ := v
    simp only at hpt
    subst hpt
    haveI := hv.fin
    exact runKind_charged_ok hc hN2 r hv.N_eq hk'
  -- orbit vertices
  have horb : ∀ v cs, T.kind v = .orbit cs →
      v.Inv N ∧ Good v ∧ (∀ u ∈ cs, u.Inv N ∧ 1 ≤ (u.leaf.state P.κ).s ∧
        (u.leaf.state P.κ).s < (v.leaf.state P.κ).s ∧
        GI.Paper.OrbitChild (v.leaf.state P.κ) (u.leaf.state P.κ)) ∧
      (cs.map fun u => (u.leaf.state P.κ).s).sum ≤ (v.leaf.state P.κ).s := by
    intro v cs hk
    obtain ⟨hv, hg, hpt, hk'⟩ := phaseTreeOn_orbit hk
    refine ⟨hv, hg, ?_⟩
    obtain ⟨Ω, m, C, S, L, A, r, pt⟩ := v
    simp only at hpt
    subst hpt
    haveI := hv.fin
    exact runKind_orbit_ok r hv.N_eq hκ (hv.orbit_h rfl) hk'
  -- the state of a charged child
  have hchildst : ∀ v cls, T.kind v = .charged cls → ∀ c ∈ cls, ∀ b ∈ c.branches, ∀ u ∈ b,
      T.state u = vstate P Qf u := by
    intro v cls hk c hc' b hb u hu
    obtain ⟨hv, hg, -, hok⟩ := hcls v cls hk
    have hinv := (hok c hc').inv b hb u hu
    have hchild : u ∈ v.rawKind.children := by
      obtain ⟨-, -, hpt, hk'⟩ := phaseTreeOn_charged hk
      have : v.rawKind = .charged cls := by
        unfold PNode.rawKind; rw [hpt]; exact hk'
      rw [this]; exact mem_children_of_class hc' hb hu
    exact hst u hinv (hclosed v hv hg u hchild hinv)
  have horbst : ∀ v cs, T.kind v = .orbit cs → ∀ u ∈ cs, T.state u = vstate P Qf u := by
    intro v cs hk u hu
    obtain ⟨hv, hg, h, -⟩ := horb v cs hk
    have hinv := (h u hu).1
    have hchild : u ∈ v.rawKind.children := by
      obtain ⟨-, -, hpt, hk'⟩ := phaseTreeOn_orbit hk
      have : v.rawKind = .orbit cs := by
        unfold PNode.rawKind; rw [hpt]; exact hk'
      rw [this]; exact hu
    exact hst u hinv (hclosed v hv hg u hchild hinv)
  -- the size and multiplicity fields only read `s`
  have hvstate_s : ∀ v, (vstate P Qf v).s = (v.leaf.state P.κ).s := fun v => rfl
  have hval : ∀ v cls, T.kind v = .charged cls → ∀ c ∈ cls, c.row.Valid cc (T.state v) := by
    intro v cls hk c hc'
    obtain ⟨hv, hg, -, hok⟩ := hcls v cls hk
    rw [hst v hv hg]
    exact valid_withQ cc (hok c hc').valid
  refine
    { nonneg := ?_
      leaf_small := ?_
      leaf_cost := leaf_cost
      internal_large := ?_
      toll := toll
      classes_le := ?_
      class_valid := hval
      branch_pos := ?_
      branch_disjoint := ?_
      branch_child := ?_
      orbit_pos := ?_
      orbit_disjoint := ?_
      orbit_child := ?_
      class_fam := ?_ }
  · intro v
    by_cases hv : v.Inv N ∧ Good v
    · rw [hst v hv.1 hv.2]
      exact ⟨State.hierRho_nonneg _, Nat.cast_nonneg _, hq0 _⟩
    · rw [phaseTreeOn_state_not hv]; simp
  · intro v hk
    by_cases hv : v.Inv N ∧ Good v
    · rw [hst v hv.1 hv.2, hvstate_s]
      rw [phaseTreeOn_kind_of hv.1 hv.2] at hk
      obtain ⟨Ω, m, C, S, L, A, r, pt⟩ := v
      haveI := hv.1.fin
      have hthr : r.kind = .threshold → (S.size : ℝ) ≤ (N : ℝ) ^ cc.γ := by
        intro hr
        cases r <;> simp [Run.kind] at hr
        rename_i hs _
        rw [hγ, ← hv.1.N_eq]; exact hs
      cases pt with
      | none =>
        have : runKind r = .leaf := hk
        exact hthr ((runKind_leaf r hv.1.mode).1 this)
      | some a =>
        obtain ⟨hr, ha⟩ := hv.1.virt a rfl
        refine le_trans ?_ (hthr hr)
        change ((Nat.card (orb S.G a) : ℕ) : ℝ) ≤ ((Nat.card S.dom : ℕ) : ℝ)
        exact_mod_cast Nat.card_mono (Set.toFinite _) (orb_subset S.dom_inv ha)
    · rw [phaseTreeOn_state_not hv]
      simp only [CharP.cast_eq_zero]
      exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  · intro v hk
    by_cases hv : v.Inv N ∧ Good v
    · rw [hst v hv.1 hv.2, hvstate_s]
      rw [phaseTreeOn_kind_of hv.1 hv.2] at hk
      obtain ⟨Ω, m, C, S, L, A, r, pt⟩ := v
      cases pt with
      | none =>
        have hk' : runKind r ≠ .leaf := hk
        have hthr : r.kind ≠ .threshold := fun h => hk' ((runKind_leaf r hv.1.mode).2 h)
        have := Run.internal_large r hv.1.mode hthr
        rw [hγ, ← hv.1.N_eq]
        exact this
      | some a => exact absurd rfl hk
    · exact absurd (phaseTreeOn_kind_not hv) hk
  · intro v cls hk
    exact (hcls v cls hk).2.2.1.trans (by exact_mod_cast hc.J_six)
  · intro v cls hk c hc' b hb u hu
    have h := (hcls v cls hk).2.2.2 c hc'
    rw [hchildst v cls hk c hc' b hb u hu, hvstate_s]
    exact h.pos b hb u hu
  · intro v cls hk c hc' b hb
    have h := (hcls v cls hk).2.2.2 c hc'
    obtain ⟨hv, hg, -, -⟩ := hcls v cls hk
    rw [List.map_congr_left (fun u hu => by rw [hchildst v cls hk c hc' b hb u hu, hvstate_s])]
    rw [hst v hv hg, hvstate_s]
    exact h.disj b hb
  · intro v cls hk c hc' b hb u hu
    have h := (hcls v cls hk).2.2.2 c hc'
    obtain ⟨hv, hg, hpt, hk'⟩ := phaseTreeOn_charged hk
    rw [hchildst v cls hk c hc' b hb u hu, hst v hv hg]
    exact child_withQ cc (h.child b hb u hu) (hq_charged v hv hg hpt cls hk' c hc' b hb u hu)
  · intro v cs hk u hu
    obtain ⟨hv, hg, h, -⟩ := horb v cs hk
    obtain ⟨h1, h2, h3, -⟩ := h u hu
    rw [horbst v cs hk u hu, hst v hv hg]
    exact ⟨h2, h3⟩
  · intro v cs hk
    obtain ⟨hv, hg, -, h⟩ := horb v cs hk
    rw [List.map_congr_left (fun u hu => by rw [horbst v cs hk u hu, hvstate_s])]
    rw [hst v hv hg, hvstate_s]
    exact h
  · intro v cs hk u hu
    obtain ⟨hv, hg, h, -⟩ := horb v cs hk
    obtain ⟨h1, -, -, h4⟩ := h u hu
    obtain ⟨-, -, hpt, hk'⟩ := phaseTreeOn_orbit hk
    rw [horbst v cs hk u hu, hst v hv hg]
    exact orbitChild_withQ h4 (hq_orbit v hv hg hpt cs hk' u hu)
  · intro v cls hk c hc'
    obtain ⟨hv, hg, hpt, hk'⟩ := phaseTreeOn_charged hk
    obtain ⟨Ω, m, C, S, L, A, r, pt⟩ := v
    simp only at hpt
    subst hpt
    haveI := hv.fin
    have hb : r.VertexBound cc d := hbound _ hv hg
    obtain ⟨M, fam, hM, hfam⟩ := runKind_class_fam hc hN2 hab r hv.N_eq hb hk' c hc'
    have hstv : (T.state ⟨Ω, m, C, S, L, A, r, none⟩).s = S.size := by
      rw [hst _ hv hg]; rfl
    simp only [hstv]
    refine ⟨M, fam, ?_, fun j => ?_⟩
    · have hval' : c.row.Valid cc (S.res P.κ) := by
        have := (hcls _ cls hk).2.2.2 c hc'
        exact this.valid
      exact hM.trans (multL_mono cc hΛ0 hΛ hval')
    · refine le_trans (le_of_eq ?_) (hfam j)
      apply Finset.sum_congr rfl
      intro i _
      apply congrArg
      apply List.map_congr_left
      intro u hu
      rw [hchildst _ cls hk c hc' _ (List.get_mem _ _) u hu, hvstate_s]

/-- Lemma 7.1 on the restricted phase tree of `M.Run`, with weight `Λ` and cap moment `Qf`. -/
theorem real_runs_cost_le {cc : ChargingConstants} (hc : Compat P cc) (hN6 : 6 ≤ (N : ℝ) ^ cc.γ)
    (hN2 : 2 ≤ (N : ℝ) ^ (cc.γ * cc.D - cc.a))
    {d : ℕ} (hab : ((2 * P.κ : ℕ) : ℝ) + Real.log (9 : ℕ) / Real.log 48 ≤ cc.aStar)
    {K : ℝ} (hK : 0 ≤ K) {Λ : ℝ} (hΛ : lam d ≤ Λ)
    (hclosed : ∀ v, v.Inv N → Good v → ∀ u, u ∈ v.rawKind.children → u.Inv N → Good u)
    (hbound : ∀ v, v.Inv N → Good v → v.leaf.run.VertexBound cc d)
    (hq0 : ∀ {Ω : Type} (l : List (Interval Ω)), 0 ≤ Qf l)
    (hq_charged : ∀ v, v.Inv N → Good v → v.leaf.pt = none → ∀ cls,
      runKind v.leaf.run = .charged cls → ∀ c ∈ cls, ∀ b ∈ c.branches, ∀ u ∈ b,
        qClause cc (Qf v.leaf.S.hier) (Qf u.leaf.S.hier) c.row)
    (hq_orbit : ∀ v, v.Inv N → Good v → v.leaf.pt = none → ∀ cs,
      runKind v.leaf.run = .orbit cs → ∀ u ∈ cs, Qf u.leaf.S.hier ≤ Qf v.leaf.S.hier)
    (leaf_cost : ∀ v, (phaseTreeOn P N cost Good Qf).kind v = .leaf → cost v ≤ K)
    (toll : ∀ v, (phaseTreeOn P N cost Good Qf).kind v ≠ .leaf →
      cost v ≤ (N : ℝ) ^ cc.a * K +
        (((phaseTreeOn P N cost Good Qf).kind v).children.map cost).sum) :
    WellFounded (fun u v => u ∈ ((phaseTreeOn P N cost Good Qf).kind v).children) ∧
    ∀ v, cost v ≤ K * GI.DegreeD.weight cc.D ((phaseTreeOn P N cost Good Qf).state v).s
      (GI.DegreeD.ΦL cc.A cc.B (fun _ => Λ) ((phaseTreeOn P N cost Good Qf).state v)) := by
  have hΛxZero : xZero ≤ Λ := (xZero_le_lam d).trans hΛ
  have h := phaseTreeOn_hypL hc hN6 hab K hΛ hclosed hbound hq0 hq_charged hq_orbit leaf_cost toll
  exact h.cost_le (const_weightFn hΛxZero) hN6 hN2 hK

end Restricted

end GI.DegreeD.M
